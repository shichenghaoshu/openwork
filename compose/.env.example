OPENWORK_DB_PASSWORD=replace-with-a-long-random-password
OPENWORK_API_TOKEN=replace-with-at-least-32-random-characters
OPENWORK_API_ACTOR=control-admin
OPENWORK_CONTROL_PORT=8080
# Existing absolute host directory exposed read-only as the Control API trust root.
OPENWORK_HOST_WORKSPACE_ROOT=/srv/openwork/workspaces
OPENWORK_LITELLM_PORT=4000
LITELLM_MASTER_KEY=replace-only-when-using-the-gateway-profile

# Host-run worker settings (not enabled in the socket-free Compose control API).
# OPENWORK_WORKER_ENABLED=1
# OPENWORK_DOCKER_BIN=/usr/bin/docker
# OPENWORK_WORKER_TEMP_ROOT=/var/lib/openwork/sandbox-tmp
# OPENWORK_WORKER_OUTPUT_ROOT=/var/lib/openwork/outputs
# OPENWORK_CODEX_IMAGE=registry.example/openwork/codex@sha256:replace-with-provenance-checked-digest
# OPENWORK_CODEX_EXECUTABLE=/usr/local/bin/codex
# OPENWORK_CLAUDE_IMAGE=registry.example/openwork/claude@sha256:replace-with-provenance-checked-digest
# OPENWORK_CLAUDE_EXECUTABLE=/usr/local/bin/claude
# OPENWORK_WORKER_ACTOR=worker:local

# Host-run read-only MCP discovery. Secrets are forwarded to the connector
# child process as environment variables and are never returned by the API.
# OPENWORK_GITHUB_TOKEN=github_pat_replace_with_minimum_read_scopes
# OPENWORK_GITHUB_MCP_DOCKER_BIN=/usr/local/bin/docker
# OPENWORK_DOCKER_HOST=unix:///var/run/docker.sock
# OPENWORK_LARK_APP_ID=cli_replace
# OPENWORK_LARK_APP_SECRET=replace
# OPENWORK_LARK_MCP_NPX_BIN=/opt/homebrew/bin/npx
# OPENWORK_LARK_DOMAIN=https://open.feishu.cn
